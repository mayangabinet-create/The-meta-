# Supabase project (Settings → API). Uses the service-role key because all
# database access happens server-side only — the browser never talks to
# Supabase directly, so RLS can stay locked down with no public policies.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for receipt scanning (console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5.
ANTHROPIC_MODEL=
